services:
  postgres:
    image: postgres:16-alpine
    container_name: ai-review-postgres
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-ai_code_review}
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Copy .env.example to .env and set POSTGRES_PASSWORD}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    container_name: ai-review-redis
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redis_data:/data
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  qdrant:
    image: qdrant/qdrant:v1.13.1
    container_name: ai-review-qdrant
    ports:
      - "6333:6333"
    volumes:
      - qdrant_data:/qdrant/storage
    healthcheck:
      test:
        - CMD
        - bash
        - -c
        - >-
          exec 3<>/dev/tcp/127.0.0.1/6333 &&
          printf 'GET /readyz HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' >&3 &&
          IFS= read -r response <&3 &&
          [[ "$$response" == *"200 OK"* ]]
      interval: 10s
      timeout: 5s
      retries: 10
    restart: unless-stopped

  gateway:
    build:
      context: ./gateway
    container_name: ai-review-gateway
    env_file:
      - path: .env
        required: false
    environment:
      APP_NAME: ${APP_NAME:-AI Code Review Gateway}
      ENVIRONMENT: ${ENVIRONMENT:-development}
      DATABASE_URL: postgresql+psycopg2://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:?Copy .env.example to .env and set POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-ai_code_review}
      SECRET_KEY: ${SECRET_KEY:?Copy .env.example to .env and replace SECRET_KEY}
      ALGORITHM: ${ALGORITHM:-HS256}
      AUTH_SERVICE: http://auth-service:8001
      REPOSITORY_SERVICE: http://repository-service:8000
      REVIEW_SERVICE: http://review-service:8000
      AI_SERVICE: http://ai-service:8000
      CHAT_SERVICE: http://repository-service:8000
    depends_on:
      postgres:
        condition: service_healthy
      auth-service:
        condition: service_started
      repository-service:
        condition: service_started
      review-service:
        condition: service_started
      ai-service:
        condition: service_started
    ports:
      - "8000:8000"
    healthcheck:
      test: ["CMD-SHELL", "python - <<'PY'
import urllib.request; urllib.request.urlopen('http://localhost:8000/', timeout=5)
PY"]
      interval: 15s
      timeout: 10s
      retries: 5
    restart: unless-stopped

  auth-service:
    build:
      context: ./services/auth-service
    container_name: ai-review-auth-service
    env_file:
      - path: .env
        required: false
    environment:
      APP_NAME: ${APP_NAME:-AI Code Review Auth Service}
      ENVIRONMENT: ${ENVIRONMENT:-development}
      DATABASE_URL: postgresql+psycopg2://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:?Copy .env.example to .env and set POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-ai_code_review}
      SECRET_KEY: ${SECRET_KEY:?Copy .env.example to .env and replace SECRET_KEY}
      ALGORITHM: ${ALGORITHM:-HS256}
      HOST: 0.0.0.0
      PORT: 8001
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "8001:8001"
    restart: unless-stopped

  ai-service:
    build:
      context: ./services/ai-service
    container_name: ai-review-ai-service
    env_file:
      - path: .env
        required: false
    environment:
      APP_NAME: ${APP_NAME:-AI Code Review AI Service}
      ENVIRONMENT: ${ENVIRONMENT:-development}
      OLLAMA_URL: ${OLLAMA_URL:-http://host.docker.internal:11434}
      HOST: 0.0.0.0
      PORT: 8000
    ports:
      - "8002:8000"
    restart: unless-stopped

  repository-service:
    build:
      context: ./services/repository-service
    container_name: ai-review-repository-service
    env_file:
      - path: .env
        required: false
    environment:
      APP_NAME: ${APP_NAME:-AI Code Review Repository Service}
      ENVIRONMENT: ${ENVIRONMENT:-development}
      DATABASE_URL: postgresql+psycopg2://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:?Copy .env.example to .env and set POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-ai_code_review}
      SECRET_KEY: ${SECRET_KEY:?Copy .env.example to .env and replace SECRET_KEY}
      ALGORITHM: ${ALGORITHM:-HS256}
      GITHUB_TOKEN: ${GITHUB_TOKEN:?Copy .env.example to .env and set GITHUB_TOKEN}
      GITHUB_WEBHOOK_SECRET: ${GITHUB_WEBHOOK_SECRET:-}
      OLLAMA_URL: ${OLLAMA_URL:-http://host.docker.internal:11434}
      QDRANT_HOST: qdrant
      QDRANT_PORT: 6333
      REDIS_URL: redis://redis:6379/0
      HOST: 0.0.0.0
      PORT: 8000
    depends_on:
      postgres:
        condition: service_healthy
      qdrant:
        condition: service_started
      redis:
        condition: service_healthy
    ports:
      - "8003:8000"
    restart: unless-stopped

  review-service:
    build:
      context: ./services/review-service
    container_name: ai-review-review-service
    env_file:
      - path: .env
        required: false
    environment:
      APP_NAME: ${APP_NAME:-AI Code Review Review Service}
      ENVIRONMENT: ${ENVIRONMENT:-development}
      DATABASE_URL: postgresql+psycopg2://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:?Copy .env.example to .env and set POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-ai_code_review}
      HOST: 0.0.0.0
      PORT: 8000
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "8004:8000"
    restart: unless-stopped

  celery-worker:
    build:
      context: ./services/repository-service
    container_name: ai-review-celery-worker
    env_file:
      - path: .env
        required: false
    environment:
      ENVIRONMENT: ${ENVIRONMENT:-development}
      DATABASE_URL: postgresql+psycopg2://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:?Copy .env.example to .env and set POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-ai_code_review}
      SECRET_KEY: ${SECRET_KEY:?Copy .env.example to .env and replace SECRET_KEY}
      ALGORITHM: ${ALGORITHM:-HS256}
      GITHUB_TOKEN: ${GITHUB_TOKEN:?Copy .env.example to .env and set GITHUB_TOKEN}
      GITHUB_WEBHOOK_SECRET: ${GITHUB_WEBHOOK_SECRET:-}
      OLLAMA_URL: ${OLLAMA_URL:-http://host.docker.internal:11434}
      QDRANT_HOST: qdrant
      QDRANT_PORT: 6333
      REDIS_URL: redis://redis:6379/0
    depends_on:
      redis:
        condition: service_healthy
      postgres:
        condition: service_healthy
      qdrant:
        condition: service_started
    command: ["celery", "-A", "app.core.celery_app:celery_app", "worker", "--loglevel=info"]
    restart: unless-stopped

volumes:
  postgres_data:
  redis_data:
  qdrant_data:
