# Development template only. Copy to .env and replace every placeholder.
# Production startup rejects placeholder JWT secrets; never deploy this file unchanged.
POSTGRES_DB=ai_code_review
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_local_database_password
APP_NAME=AI Code Review Platform
ENVIRONMENT=development
SECRET_KEY=replace_with_at_least_32_chars_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_SERVICE=http://auth-service:8001
REPOSITORY_SERVICE=http://repository-service:8000
REVIEW_SERVICE=http://review-service:8000
AI_SERVICE=http://ai-service:8000
GITHUB_TOKEN=replace_with_github_token
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
REDIS_URL=redis://redis:6379/0
QDRANT_HOST=qdrant
QDRANT_PORT=6333
